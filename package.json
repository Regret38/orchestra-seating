{
  "name": "orchestra-seating",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "오케스트라 무대 의자·보면대 배치 및 준비 수량 계산 웹 프로그램",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
